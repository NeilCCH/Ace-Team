# 到 https://console.anthropic.com 申請並貼上你的 API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 選填，不設定時預設用 claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# 存取控制（必填，缺任一項會讓所有人都被擋在登入頁外）
# 允許登入的 email，用逗號分隔，不分大小寫
ALLOWED_EMAILS=neil@example.com,someone@example.com
# 所有允許登入的人共用的存取碼，由你自訂、自行分發給使用者
ACCESS_CODE=change-me
# 用來簽署登入 session 的隨機字串，自己亂打一串長字串即可，不要外流
SESSION_SECRET=change-me-to-a-long-random-string

# 選填：個案記錄與儀表板用的 Postgres 連線字串（例如 Vercel 整合 Neon 後拿到的值）。
# 沒設定時，教練陪練功能照常可用，只是不會記錄個案、儀表板會顯示讀取失敗。
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
