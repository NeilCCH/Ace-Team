# 到 https://console.anthropic.com 申請並貼上你的 API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 選填，不設定時預設用 claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# 存取控制（必填，缺任一項會讓所有人都被擋在登入頁外）
# 允許登入的 email，用逗號分隔，不分大小寫
ALLOWED_EMAILS=neil@example.com,someone@example.com
# 所有允許登入的人共用的存取碼，由你自訂、自行分發給使用者
ACCESS_CODE=change-me
# 用來簽署登入 session 的隨機字串，自己亂打一串長字串即可，不要外流
SESSION_SECRET=change-me-to-a-long-random-string

# 選填：個案記錄與儀表板用的 Postgres 連線字串。兩個名稱都接受，本機開發
# 自己建的資料庫習慣用 DATABASE_URL；透過 Vercel 的 Neon 整合連接時，實際
# 變數名稱依當初設定的 custom prefix 而定（這個專案是 POSTGRES_URL，不是
# DATABASE_URL——串接前先去 Vercel 專案的 Environment Variables 確認實際
# 名稱，不要假設一定是 DATABASE_URL）。
# 沒設定時，教練陪練功能照常可用，只是不會記錄個案、儀表板會顯示讀取失敗。
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
